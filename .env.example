# Copy this file to .env and fill in the values. Never commit the real .env.

# Read-only Postgres role on the SAME Supabase database built in Project A.
# Create the role with sql/00_readonly_role.sql, then use its credentials here.
DATABASE_URL_READONLY=postgresql://t2sql_readonly.<project-ref>:<password>@<pooler-host>:5432/postgres

# Free LLM API keys
GEMINI_API_KEY=
GROQ_API_KEY=
