# Copy this file to .env and fill in the values. Never commit the real .env.

# Read-only Postgres role on the SAME Supabase database built in Project A.
# Create the role with sql/00_readonly_role.sql, then use its credentials here.
DATABASE_URL_READONLY=postgresql://t2sql_readonly:PASSWORD@HOST:5432/postgres

# Free LLM API keys
GEMINI_API_KEY=          # https://aistudio.google.com/app/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
